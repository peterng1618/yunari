{
  "$schema": "./src/web/node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "maxSize": 2097152,
    "includes": [
      "src/web/**/*.ts",
      "src/web/**/*.tsx",
      "src/web/**/*.json",
      "src/web/**/*.css",
      "src/web/packages/host/src/themes/ffmpeg-hash.mjs",
      "!src/web/packages/host/src/assets/icons/*.generated.ts"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2 },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "nursery": { "noFloatingPromises": "error" },
      "suspicious": { "noDoubleEquals": "error" }
    }
  }
}
