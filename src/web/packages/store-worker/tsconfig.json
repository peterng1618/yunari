{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // Workers runtime, and no DOM at runtime. The DOM lib is here only because
    // renderer-core is consumed as source: its barrel names `HTMLElement` and
    // `document`, which TypeScript must resolve even though workerd has neither.
    // The declarations do coexist with workers-types under `skipLibCheck`.
    "lib": ["ES2022", "DOM"],
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
