{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    // renderer-core is consumed as source, so the program spans two workspace
    // packages and rootDir has to cover both or TS6059 fires for every shared
    // file. Same arrangement as the player and fake-source.
    "rootDir": "../..",
    "paths": {
      "@/*": ["./src/*"],
      "lucide-react/dist/esm/icons/*": ["./src/lucide-icon-node.d.ts"],
      "@yunari/renderer-core": ["../renderer-core/src/index.ts"],
      "@yunari/scene-fabric": ["../scene-fabric/src/index.ts"],
      "@yunari/fake-source": ["../fake-source/src/index.ts"]
    }
  },
  // The second entry is the shared narrow Node typings, owned by
  // renderer-core. The architecture tests in src/core walk the source tree,
  // and `@types/node` is deliberately absent so `fs` cannot type-check inside
  // a browser bundle. See that file's header.
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "../renderer-core/src/node-builtins.d.ts"
  ]
}
