{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // `public/` holds the pages the host serves as source, and a test imports
    // the module they share. They are not emitted or bundled, so the browser
    // runs the same file; allowing JavaScript only makes it importable here.
    "allowJs": true,
    // renderer-core is consumed as source, so the program spans two workspace
    // packages and rootDir has to cover both or TS6059 fires for every shared
    // file. Same arrangement as the player and fake-source.
    "rootDir": "../..",
    // This package runs in Node, not a browser. DOM stays in `lib` from the
    // base config and is harmless — but `types` must include node, or every
    // `node:` import is unresolved.
    "types": ["node"],
    // The chooser admin entry is React, bundled separately from the Node host
    // by `vite.admin.config.ts`.
    "jsx": "react-jsx",
    "paths": {
      "@yunari/renderer-core": ["../renderer-core/src/index.ts"],
      "@yunari/theme-kit": ["../theme-kit/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
