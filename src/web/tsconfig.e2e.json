{
  // The e2e suite is its own program: it needs Playwright's types and the DOM,
  // and folding them into an editor program would weaken what that one checks.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // The host workspace declares @types/node; npm hoists it, and the type
    // directive resolves it wherever it lands rather than naming one path.
    "types": ["node"]
  },
  "include": ["tests/e2e/**/*.ts"]
}
