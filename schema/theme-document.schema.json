{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yunari.local/schema/theme-document/2.json",
  "title": "Yunari Fabric theme envelope",
  "description": "The published Yunari theme format. Fabric owns scene geometry and object state; Yunari owns the versioned semantic envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fabricVersion", "id", "artboard", "scene"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "fabricVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "id": { "$ref": "#/$defs/stableId" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "artboard": { "$ref": "#/$defs/artboard" },
    "background": { "$ref": "#/$defs/background" },
    "globals": { "$ref": "#/$defs/globals" },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/assetReference" } },
    "bindings": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/stableId" },
      "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/binding" } }
    },
    "editorMetadata": { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } },
    "scene": { "$ref": "#/$defs/fabricScene" }
  },
  "$defs": {
    "stableId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "metadata": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "author": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "themeLanguage": { "type": "string", "maxLength": 64 },
        "tags": { "type": "array", "maxItems": 5, "items": { "type": "string", "pattern": "^[a-z0-9-]{1,24}$" } },
        "remixOf": { "$ref": "#/$defs/remix" }
      }
    },
    "remix": {
      "description": "The catalogue item this theme was remixed from — the immediate parent only, recorded as provenance for the credit line. The parent's existence is not checked.",
      "type": "object", "additionalProperties": false, "required": ["catalogueId", "name", "version"],
      "properties": {
        "catalogueId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
      }
    },
    "paletteReference": {
      "type": "object", "additionalProperties": false, "required": ["ref"],
      "properties": { "ref": { "type": "string", "pattern": "^palette\\.[A-Za-z0-9_-]{1,64}$" } }
    },
    "artboard": {
      "type": "object", "additionalProperties": false, "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 16384 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 16384 },
        "contentFit": { "enum": ["contain", "cover"] }
      }
    },
    "background": {
      "description": "The bottom-most layer: a colour behind the board and optional media clipped to its bounds.",
      "type": "object", "additionalProperties": false,
      "properties": {
        "color": { "$ref": "#/$defs/paletteReference" },
        "media": { "$ref": "#/$defs/backgroundMedia" }
      }
    },
    "backgroundMedia": {
      "type": "object", "additionalProperties": false, "required": ["assetId", "bounds"],
      "properties": {
        "assetId": { "$ref": "#/$defs/stableId" },
        "bounds": { "enum": ["theme", "display"] },
        "offsetX": { "type": "number", "minimum": -1, "maximum": 1 },
        "offsetY": { "type": "number", "minimum": -1, "maximum": 1 },
        "flipX": { "type": "boolean" },
        "flipY": { "type": "boolean" }
      }
    },
    "globals": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "palette": { "$ref": "#/$defs/paletteGroup" },
        "typePresets": { "$ref": "#/$defs/typePresetGroup" }
      }
    },
    "paletteGroup": {
      "type": "object", "required": ["none"], "propertyNames": { "$ref": "#/$defs/stableId" },
      "properties": {
        "none": {
          "type": "object", "additionalProperties": false, "required": ["name", "value"],
          "properties": { "name": { "const": "None" }, "value": { "$ref": "#/$defs/transparentPaint" } }
        }
      },
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["name", "value"],
        "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 120 }, "value": { "$ref": "#/$defs/palettePaint" } }
      }
    },
    "typePresetGroup": {
      "type": "object", "propertyNames": { "$ref": "#/$defs/stableId" },
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["name", "value"],
        "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 120 }, "value": { "$ref": "#/$defs/typePreset" } }
      }
    },
    "typePreset": {
      "type": "object", "additionalProperties": false, "required": ["family", "size", "face"],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "size": { "type": "number", "exclusiveMinimum": 0 },
        "weight": { "oneOf": [{ "type": "string" }, { "type": "number" }] },
        "letterSpacing": { "type": "number" },
        "lineHeight": { "type": "number", "exclusiveMinimum": 0 },
        "face": { "$ref": "#/$defs/fontFaceReference" },
        "trioRole": { "enum": ["heading", "body", "mono"] }
      }
    },
    "fontFaceReference": { "type": "object", "additionalProperties": false, "required": ["assetId"], "properties": { "assetId": { "$ref": "#/$defs/stableId" } } },
    "transparentPaint": {
      "type": "object", "additionalProperties": false, "required": ["kind", "color"],
      "properties": { "kind": { "const": "solid" }, "color": { "const": "transparent" } }
    },
    "palettePaint": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "color"], "properties": { "kind": { "const": "solid" }, "color": { "type": "string", "minLength": 1 } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "angle", "stops"], "properties": { "kind": { "const": "gradient" }, "angle": { "type": "number" }, "stops": { "type": "array", "minItems": 2, "items": { "type": "object", "additionalProperties": false, "required": ["offset", "color"], "properties": { "offset": { "type": "number", "minimum": 0, "maximum": 1 }, "color": { "type": "string", "minLength": 1 } } } } } }
      ]
    },
    "assetReference": {
      "oneOf": [{ "$ref": "#/$defs/fontAssetReference" }, { "$ref": "#/$defs/nonFontAssetReference" }]
    },
    "nonFontAssetReference": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "path"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "kind": { "enum": ["image", "svg", "video"] },
        "path": { "type": "string", "pattern": "^assets/[A-Za-z0-9._/-]{1,200}$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sourceUrl": { "type": "string", "format": "uri" },
        "license": { "type": "object", "additionalProperties": false, "properties": { "name": { "type": "string", "maxLength": 200 }, "url": { "type": "string", "format": "uri" }, "attribution": { "type": "string", "maxLength": 500 } } }
      }
    },
    "fontAssetReference": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "path", "family", "weight", "style", "format", "sourceUrl", "license"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" }, "kind": { "const": "font" },
        "path": { "type": "string", "pattern": "^assets/[A-Za-z0-9._/-]{1,200}\\.woff2$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "family": { "type": "string", "minLength": 1 }, "weight": { "oneOf": [{ "type": "string" }, { "type": "number" }] },
        "style": { "enum": ["normal", "italic"] }, "format": { "const": "woff2" },
        "sourceUrl": { "type": "string", "format": "uri" },
        "license": { "type": "object", "additionalProperties": false, "required": ["name", "url"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 200 }, "url": { "type": "string", "format": "uri" }, "attribution": { "type": "string", "maxLength": 500 } } }
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false, "required": ["id", "semanticKey"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "semanticKey": { "type": "string", "minLength": 1, "maxLength": 120 },
        "precision": { "type": "integer", "minimum": 0, "maximum": 6 },
        "unitDisplay": { "enum": ["none", "short", "long"] },
        "scale": { "type": "number" }, "offset": { "type": "number" },
        "format": { "type": "string", "maxLength": 64 },
        "timeZone": { "type": "string", "maxLength": 64 }
      }
    },
    "fabricScene": {
      "description": "Fabric JSON. Yunari validates object identity, nesting bounds and JSON safety before revival.",
      "type": "object", "required": ["version", "objects"],
      "properties": {
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "objects": { "type": "array", "items": { "$ref": "#/$defs/fabricObject" } }
      },
      "additionalProperties": { "$ref": "#/$defs/jsonValue" }
    },
    "fabricObject": {
      "type": "object",
      "properties": {
        "yunariGlass": { "$ref": "#/$defs/glassTreatment" },
        "name": { "$ref": "#/$defs/objectName" }
      },
      "allOf": [
        {
          "if": { "required": ["yunariGlass"] },
          "then": {
            "properties": {
              "type": {
                "enum": ["Rect", "Circle", "Ellipse", "Triangle", "Polygon", "Wedge", "Group"]
              }
            }
          }
        }
      ],
      "additionalProperties": { "$ref": "#/$defs/jsonValue" }
    },
    "objectName": {
      "description": "Display name shown in the layer list and selection. The id stays the stable key and is what this falls back to when the name is absent.",
      "type": "string", "minLength": 1, "maxLength": 120
    },
    "glassTreatment": {
      "description": "Authored backdrop blur. Absence means off; 0 means no blur. Artboard units.",
      "type": "object", "additionalProperties": false, "required": ["blurRadius"],
      "properties": { "blurRadius": { "type": "number", "minimum": 0, "maximum": 48 } }
    },
    "jsonValue": {
      "oneOf": [
        { "type": "null" }, { "type": "boolean" }, { "type": "number" }, { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      ]
    }
  }
}
